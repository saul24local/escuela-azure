<%-- Cabecera común: requiere definir antes "String titulo" e importar org.gerdoc.util.Html --%>
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= Html.esc(titulo) %> - Sistema Escolar</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="index.jsp">Sistema Escolar</a>
        <div class="navbar-nav">
            <a class="nav-link<%= "Alumnos".equals(titulo) ? " active" : "" %>" href="Alumnos.jsp">Alumnos</a>
            <a class="nav-link<%= "Profesores".equals(titulo) ? " active" : "" %>" href="Profesores.jsp">Profesores</a>
            <a class="nav-link<%= "Materias".equals(titulo) ? " active" : "" %>" href="Materias.jsp">Materias</a>
            <a class="nav-link<%= "Alumno - Materia".equals(titulo) ? " active" : "" %>" href="AlumnoMaterias.jsp">Alumno - Materia</a>
            <a class="nav-link<%= "Profesor - Materia".equals(titulo) ? " active" : "" %>" href="ProfesorMaterias.jsp">Profesor - Materia</a>
        </div>
    </div>
</nav>
<div class="container">
<%
    Object flashMsg = session.getAttribute("flashMsg");
    if (flashMsg != null)
    {
        Object flashTipo = session.getAttribute("flashTipo");
        session.removeAttribute("flashMsg");
        session.removeAttribute("flashTipo");
%>
    <div class="alert alert-<%= Html.esc(flashTipo != null ? flashTipo : "info") %> alert-dismissible fade show" role="alert">
        <%= Html.esc(flashMsg) %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
<%
    }
%>
